import std.display
import std.input
import std.io
import std.option
import std.string

// The first line is a title; everything after it is the body.
fn main() -> Int {
    let header = stdin.readLine()
    match (header) {
        Option.Some(title) => { println("title: " + title) }
        Option.None => {
            eprintln("no input")
            return 1
        }
    }
    let body = stdin.readAll()
    println("body: ${body.length} bytes")
    return 0
}