// expect-error: use of moved value `job`
// v0.1 concurrency, rule 1: `send` **moves** a message that owns anything into
// the channel.
//
// The receiving task takes the message out and owns it from then on, so the
// sender naming it again is naming memory another thread may already have freed.
// That is a stronger reason than `push`'s: a Vec at least still exists.
//
// `Job` owns a String on purpose. A message of scalars only is plain data and is
// copied rather than moved, so the sender keeps it -- that half is
// `tests/test_232_channel_copies.psm`. The positive half of this rule is
// `tests/test_96_channels.psm`, whose sends are all received, used and released
// -- without it this file would pass with channels removed from the language
// entirely.

import std.io

struct Job {
    name: String
}

fn main() -> Int {
    let c = Channel<Job>(2)
    let job = Job { name: "seven" }
    c.send(job)
    println(job.name)
    c.close()
    c.free()
    return 0
}
