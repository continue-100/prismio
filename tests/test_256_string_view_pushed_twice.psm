// An element read pushed into two containers, with the one it came from. Stored
// as it is, that is three holders of one block, and releasing it from each is a
// double free -- which is what the first version of test_255's rule did. A String
// pushed or inserted into a `Vec<String>` that is a view of another collection is
// therefore copied into a block of its own at the push (`fatMarkedAsView` in
// src/ir/expr.psm marks it a view, which list_push_str and str_own copy out), and
// the analysis counts that store as the copy (`aif_con_retain_in_string`). The two
// have to agree: a copy the analysis does not know about leaks the original, and
// a copy that is not made is a double free. The guard is 0 violations and 0 leaked.
//
// The same holds for a value moved out of one Vec with `pop`, `removeFirst` or
// `swapRemove` and pushed into another (test_255's neighbours in the probe).

import std.io
import std.vec
import std.string
import std.option

fn word(i: Int) -> String {
    return "word-".concat(i.toString(), "-long-enough-to-live-on-the-heap")
}

fn main() -> Int {
    let mut s: Vec<String> = []
    for i in 0..<4 { s.push(word(i)) }
    let mut c: Vec<String> = []
    let mut d: Vec<String> = []
    c.push(s[0])
    d.push(s[0])
    if (c.length + d.length != 2 or c[0] != d[0]) { return 1 }
    return 0
}
